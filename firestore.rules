rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Regla global de denegación por defecto (Principio de Menor Privilegio - OWASP A01)
    match /{document=**} {
      allow read, write: if false;
    }

    // Colección de Propuestas Comerciales
    match /proposals/{proposalId} {
      // Lectura permitida si está autenticado en Autogestión, o lectura pública por token
      allow read: if request.auth != null || resource.data.token != null;
      // Creación, edición general y eliminación restringidas a operadores autenticados
      allow create, delete: if request.auth != null;
      // Edición: autenticado O cliente aceptando la propuesta puntualmente
      allow update: if request.auth != null 
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt', 'clientLegalName', 'clientTaxId', 'clientAddress', 'clientEmail', 'updatedAt'])
            && request.resource.data.status == 'aceptado');
    }

    // Directorio de Clientes (CRM) - Privado
    match /clients/{clientId} {
      allow read, write: if request.auth != null;
    }

    // Tablero de Proyectos - Privado con excepción de encuestas públicas
    match /projects/{projectId} {
      allow read: if request.auth != null || resource.data.reviewToken != null;
      allow create, delete: if request.auth != null;
      allow update: if request.auth != null 
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewCompleted', 'reviewStars', 'reviewComment', 'updatedAt']));
    }

    // Registro de Cobranzas y Pagos - Estrictamente privado
    match /payments/{paymentId} {
      allow read, write: if request.auth != null;
    }

    // Mensajes de Contacto Web
    match /contacto/{messageId} {
      // Permite envío público desde la web
      allow create: if request.resource.data.email is string 
                    && request.resource.data.name is string 
                    && request.resource.data.message is string;
      // Solo el panel de Autogestión autenticado puede leer y borrar mensajes
      allow read, delete: if request.auth != null;
      allow update: if false;
    }

    // Configuración comercial del sitio (Settings)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Usuarios y lista blanca de acceso (RBAC)
    match /usuarios/{userId} {
      allow read: if request.auth != null;
      allow write: if false; // Solo administradores desde Firebase Console
    }
  }
}
